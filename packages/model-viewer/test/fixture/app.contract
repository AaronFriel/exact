use ModelNode, ModelViewerState from "@exact/model-viewer"

component App
  state picked = ""
  state src = "assets/assembly.glb"
  state orbit = "0deg 90deg 105%"
  state occlusion = true
  state coloured = false
  state faded = false
  state hidden = false
  state clipped = false
  resource viewer = exactSurface("modelViewer") as shape ModelViewerState
  action pick(name: string)
    picked = name
  action front
    orbit = "0deg 90deg 105%"
    postMessage("reset", "modelViewer")
  action top
    orbit = "0deg 0deg 105%"
    postMessage("reset", "modelViewer")
  action reset
    postMessage("reset", "modelViewer")
  action toggleOcclusion
    occlusion = not occlusion
  action toggleColour
    coloured = not coloured
  action toggleOpacity
    faded = not faded
  action toggleHidden
    hidden = not hidden
  action toggleClip
    clipped = not clipped
  action loadPlain
    src = "assets/assembly.glb"
  action loadMeshopt
    src = "assets/assembly-meshopt.glb"
  action replaceTwice
    src = "assets/assembly.glb"
    src = "assets/assembly-meshopt.glb"
  action missing
    src = "assets/missing.glb"
  action truncated
    src = "assets/truncated.glb"
  action url
    src = "https://example.org/model.glb"
  view
    column gap=8 padding=8
      text "Model viewer" role="heading" aria-level=1
      canvas surface=modelViewer(src=src, cameraControls=true, cameraOrbit=orbit, cameraTarget="0m 0m 0m", nodes=[ModelNode(name="Housing", color=(coloured ? "#0080ff" : ""), opacity=(faded ? 0.25 : 1), visibility=(hidden ? "hidden" : "visible"), occlusion=(occlusion ? "occluder" : "none"), occludedOpacity=0.3), ModelNode(name="Impeller", color="", opacity=1, visibility="visible", occlusion=(occlusion ? "revealed" : "none"), occludedOpacity=0.3)], clipPosition="0m 0m 0m", clipNormal=(clipped ? "0 0 -1" : "")) message=pick width=320 height=320 flex-shrink=0 role="group" aria-label="Pump assembly" testId="pump"
        if not viewer.presented
          text "Loading model" position="absolute" inset=0 aria-busy=true testId="loading"
      row gap=8
        button press=front testId="front"
          text "Front"
        button press=top testId="top"
          text "Top"
        button press=reset testId="reset"
          text "Reset"
      row gap=8
        button press=toggleOcclusion testId="occlusion"
          text "Occlusion"
        button press=toggleColour testId="colour"
          text "Colour"
        button press=toggleOpacity testId="opacity"
          text "Opacity"
        button press=toggleHidden testId="hidden"
          text "Hide"
        button press=toggleClip testId="clip"
          text "Clip"
      row gap=8
        button press=loadPlain testId="plain"
          text "Plain"
        button press=loadMeshopt testId="meshopt"
          text "Meshopt"
        button press=replaceTwice testId="replace-twice"
          text "Replace twice"
      row gap=8
        button press=missing testId="missing"
          text "Missing"
        button press=truncated testId="truncated"
          text "Truncated"
        button press=url testId="url"
          text "URL"
      text picked testId="picked"
      text viewer.error testId="error"
      text viewer.cameraOrbit testId="camera-orbit" font-variant-numeric="tabular-nums"
