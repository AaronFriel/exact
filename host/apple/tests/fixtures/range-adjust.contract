// RangeAdjustIOSTests: a drawn slider and spin button, each stepped by its own key handler.
component RangeAdjust
  state level = 50
  state floor = 3
  action stepLevel(k: string)
    if k == "ArrowRight"
      level = level + 10
    if k == "ArrowLeft"
      level = level - 10
  action stepFloor(k: string)
    if k == "ArrowUp"
      floor = floor + 1
    if k == "ArrowDown"
      floor = floor - 1
  view
    column width="100%" height="100%"
      box role="slider" tabindex=0 aria-label="Level" aria-valuenow=level aria-valuetext=`${level} percent` key=stepLevel testId="level" width=200 height=44
      box role="spinbutton" tabindex=0 aria-label="Floor" aria-valuenow=floor key=stepFloor testId="floor" width=100 height=44
